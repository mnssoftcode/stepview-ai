# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/

# Node.js & Web builds
node_modules/
web/node_modules/
web/dist/
web/public/*.wasm

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Large datasets and raw binaries (preserve directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/images/*
!data/images/.gitkeep
data/masks/*
!data/masks/.gitkeep

# Model weights and checkpoints
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx

# Allow required production ONNX models
!models/stepview_segmentation.onnx
!web/public/models/stepview_segmentation.onnx

# Experiment outputs and logs
experiments/runs/*
!experiments/runs/.gitkeep
experiments/visualizations/*
!experiments/visualizations/.gitkeep
*.log
